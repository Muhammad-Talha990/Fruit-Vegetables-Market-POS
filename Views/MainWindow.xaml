<Window x:Class="FruitVegetableMarketPOS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FruitVegetableMarketPOS.Views"
        xmlns:vm="clr-namespace:FruitVegetableMarketPOS.ViewModels"
        Title="PMC — Pak Madinah Commission Agents" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="/Assets/logo.png"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <local:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <local:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillingViewModel}">
            <local:BillingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <local:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReturnViewModel}">
            <local:ReturnView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerManagementViewModel}">
            <local:CustomerManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerLedgerViewModel}">
            <local:CustomerLedgerView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Docked sidebar (Dashboard, Items, etc.) -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" Width="200"
                Visibility="{Binding IsBillingScreen, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,12">
                    <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Ellipse Width="48" Height="48" Fill="#1B4332"/>
                        <Ellipse Width="48" Height="48">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="PMC" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" FontFamily="{DynamicResource AppFont}"/>
                    <TextBlock Text="پاک مدینہ کمیشن ایجنٹس" FontSize="11" FontWeight="SemiBold" Foreground="#BBF7D0"
                               HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                               TextAlignment="Center" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}"/>
                    <TextBlock Text="Pak Madinah Commission Agents" FontSize="9" Foreground="#86EFAC" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                               TextAlignment="Center" FontFamily="{DynamicResource AppFont}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,15">
                    <Border Background="#14532D" BorderBrush="#2D6A4F" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="{DynamicResource AppFont}"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontSize="11" Foreground="#BBF7D0"
                                       FontFamily="{DynamicResource AppFont}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{DynamicResource SidebarButton}" Command="{Binding LogoutCommand}" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource NavIcon_logout}" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Logout" Foreground="#F87171" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <local:SidebarNavPanel/>
            </DockPanel>
        </Border>

        <!-- Main content — full width on Billing -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0"/>

        <!-- Billing: left-edge hover strip -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
                Width="12" HorizontalAlignment="Left" Panel.ZIndex="200"
                Background="#1B4332" Cursor="Hand"
                ToolTip="Open menu · مینو کھولیں"
                Visibility="{Binding ShowSidebarHoverStrip, Converter={StaticResource BoolToVis}}"
                MouseEnter="HoverStrip_MouseEnter">
            <TextBlock Text="›" Foreground="#86EFAC" FontSize="13" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Billing: overlay sidebar -->
        <Border x:Name="OverlaySidebar" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource SidebarBgBrush}" Width="200"
                HorizontalAlignment="Left" Panel.ZIndex="210"
                MouseLeave="OverlaySidebar_MouseLeave">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBillingScreen}" Value="True"/>
                                <Condition Binding="{Binding IsSidebarVisible}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Direction="0" Color="Black"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,12">
                    <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Ellipse Width="48" Height="48" Fill="#1B4332"/>
                        <Ellipse Width="48" Height="48">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="PMC" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" FontFamily="{DynamicResource AppFont}"/>
                    <TextBlock Text="پاک مدینہ کمیشن ایجنٹس" FontSize="11" FontWeight="SemiBold" Foreground="#BBF7D0"
                               HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                               TextAlignment="Center" FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}"/>
                    <TextBlock Text="Pak Madinah Commission Agents" FontSize="9" Foreground="#86EFAC" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                               TextAlignment="Center" FontFamily="{DynamicResource AppFont}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,15">
                    <Border Background="#14532D" BorderBrush="#2D6A4F" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="{DynamicResource AppFont}"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontSize="11" Foreground="#BBF7D0"
                                       FontFamily="{DynamicResource AppFont}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{DynamicResource SidebarButton}" Command="{Binding LogoutCommand}" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource NavIcon_logout}" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Logout" Foreground="#F87171" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <local:SidebarNavPanel/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
