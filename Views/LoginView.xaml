<Window x:Class="FruitVegetableMarketPOS.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:FruitVegetableMarketPOS.Helpers"
        Title="PMC — Login" Height="520" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Assets/logo.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">

    <Border CornerRadius="16" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Panel.ZIndex="1" Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="16,16,0,0" Padding="14,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="PMC — Pak Madinah Commission Agents" FontSize="12" FontWeight="Bold"
                               Foreground="White" FontFamily="{DynamicResource AppFont}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,36,0"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="14" Cursor="Hand" Click="CloseButton_Click"
                            Padding="6,0"/>
                </Grid>
            </Border>

            <!-- Compact centered login form -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Width="280" Margin="0,16,0,16">

                    <!-- Logo -->
                    <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Ellipse Width="72" Height="72" Fill="#1B4332"/>
                        <Ellipse Width="72" Height="72">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <TextBlock Text="PMC" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                               FontFamily="{DynamicResource AppFont}"/>
                    <TextBlock Text="پاک مدینہ کمیشن ایجنٹس" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                               FlowDirection="RightToLeft" FontFamily="{DynamicResource AppFont}"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="Pak Madinah Commission Agents" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"
                               FontFamily="{DynamicResource AppFont}" Margin="0,1,0,4"/>
                    <TextBlock Text="Sign in to your account" FontSize="12"
                               Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"
                               FontFamily="{DynamicResource AppFont}" Margin="0,0,0,14"/>

                    <!-- Username -->
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"
                               FontFamily="{DynamicResource AppFont}"/>
                    <TextBox x:Name="UsernameTextBox" Style="{DynamicResource ModernTextBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Height="34" FontSize="13" Padding="10,4" Margin="0,0,0,10"
                             VerticalContentAlignment="Center"/>

                    <!-- Password -->
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"
                               FontFamily="{DynamicResource AppFont}"/>
                    <PasswordBox Style="{DynamicResource ModernPasswordBox}"
                                 helpers:PasswordHelper.BindPassword="True"
                                 helpers:PasswordHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" FontSize="13" Padding="10,4" Margin="0,0,0,6"
                                 VerticalContentAlignment="Center"/>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                               FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" MinHeight="14"
                               FontFamily="{DynamicResource AppFont}"/>

                    <!-- Login Button -->
                    <Button Content="Sign In" Style="{DynamicResource PrimaryButton}"
                            Command="{Binding LoginCommand}" FontSize="13"
                            Height="36" Padding="0" Margin="0,0,0,0"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
