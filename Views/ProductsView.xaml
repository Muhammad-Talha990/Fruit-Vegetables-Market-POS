<UserControl x:Class="FruitVegetableMarketPOS.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FruitVegetableMarketPOS.Converters"
             xmlns:helpers="clr-namespace:FruitVegetableMarketPOS.Helpers"
             Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource AppFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦 Item Management" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Add or update product names and category · each English name must be unique"
                       FontSize="13" Foreground="{DynamicResource SubTextBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Product List -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Margin="0,0,16,0">
                <DockPanel>
                    <!-- Search + category filters -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBox Style="{DynamicResource ModernTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="🔍 Search by name or category..."
                                 Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Cursor="Hand" Margin="0,0,8,0"
                                            Padding="14,7" FontSize="12" FontWeight="SemiBold" BorderThickness="0"
                                            Command="{Binding DataContext.SelectCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                <Setter Property="Foreground" Value="#1B5E20"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="16"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#1B4332"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Data Grid -->
                    <DataGrid ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              SelectionMode="Single"
                              Style="{DynamicResource ModernDataGrid}"
                              ColumnHeaderStyle="{DynamicResource ModernDataGridColumnHeader}"
                              CellStyle="{DynamicResource ModernDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding PosCode}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="English" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="اردو" Binding="{Binding NameUrdu}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Product Form — name + category only -->
            <Border Grid.Column="1" Style="{DynamicResource CardBorder}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="14,12,12,12">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="➕ Add Product"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Text" Value="✏️ Update Name"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Name English -->
                        <TextBlock Text="Product Name (English) *" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,2"/>
                        <TextBox Style="{DynamicResource ModernTextBox}"
                                 Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:FocusHelper.SelectAllOnFocus="True"
                                 Margin="0,0,0,10"/>

                        <!-- Name Urdu -->
                        <TextBlock Text="نام اردو *" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,2" FlowDirection="RightToLeft"/>
                        <TextBox Style="{DynamicResource ModernTextBox}" FlowDirection="RightToLeft"
                                 Text="{Binding FormNameUrdu, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:FocusHelper.SelectAllOnFocus="True"
                                 Margin="0,0,0,10"/>

                        <!-- Category -->
                        <TextBlock Text="Category · قسم *" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,2"/>
                        <ComboBox Style="{DynamicResource ModernComboBox}"
                                  ItemsSource="{Binding CategoryList}"
                                  SelectedValuePath="CategoryId"
                                  SelectedValue="{Binding FormCategoryId}"
                                  DisplayMemberPath="DisplayLabel"
                                  IsEditable="True"
                                  Text="{Binding FormCategory, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,14"/>

                        <TextBlock Text="Prices and types are set on Billing → Add Today."
                                   FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"/>

                        <!-- Add (new) -->
                        <Button Content="➕  Add Item" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding AddCommand}" Margin="0,0,0,8"
                                Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}"/>

                        <!-- Update name (edit) -->
                        <Button Content="💾  Update Name" Style="{DynamicResource AccentButton}"
                                Command="{Binding UpdateCommand}" Margin="0,0,0,8"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                        <Button Content="🔄  Clear Form" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding ClearFormCommand}" Background="#607D8B"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ POPUP SUCCESS OVERLAY ═══ -->
        <Border Grid.RowSpan="2" Panel.ZIndex="3100" IsHitTestVisible="False"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0"
                Visibility="{Binding PopupSuccessVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border Background="#F0FDF4" CornerRadius="10" Padding="24,14"
                    BorderBrush="#22C55E" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#22C55E"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✅" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding PopupSuccessMessage}"
                               Foreground="#16A34A" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ═══ POPUP ERROR OVERLAY ═══ -->
        <Border Grid.RowSpan="2" Panel.ZIndex="3000" IsHitTestVisible="False"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0"
                Visibility="{Binding PopupErrorVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border Background="White" CornerRadius="8" Padding="20,12"
                    BorderBrush="#EF4444" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="Black"/>
                </Border.Effect>
                <TextBlock Text="{Binding PopupErrorMessage}"
                           Foreground="#EF4444" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Border>
    </Grid>
</UserControl>
