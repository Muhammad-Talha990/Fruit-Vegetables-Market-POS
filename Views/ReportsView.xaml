<UserControl x:Class="FruitVegetableMarketPOS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FruitVegetableMarketPOS.Converters"
             xmlns:controls="clr-namespace:FruitVegetableMarketPOS.Views.Controls"
             Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource AppFont}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:CountToVisibilityConverter x:Key="CountToVis"/>
        <converters:CountToVisibilityConverter x:Key="InverseCountToVis" Inverse="True"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="CompactCombo" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style x:Key="ReportHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}">
            <Setter Property="Background" Value="#1B4332"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#2D6A4F"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReportCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="ReportGrid" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ReportHeader}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="False"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="ColumnWidth" Value="Auto"/>
            <Setter Property="MinRowHeight" Value="36"/>
            <EventSetter Event="PreviewMouseWheel" Handler="ReportGrid_PreviewMouseWheel"/>
            <EventSetter Event="Loaded" Handler="ReportGrid_Loaded"/>
        </Style>
        <Style x:Key="ActionGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BillsGridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ReportHeader}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AmountCellText" TargetType="TextBlock" BasedOn="{StaticResource ReportCellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="BillRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReportBillKind}" Value="Credit">
                    <Setter Property="Background" Value="#FEF3C7"/>
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReportBillKind}" Value="Payment">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReportBillKind}" Value="Paid">
                    <Setter Property="Background" Value="#ECFDF5"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BBF7D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiptRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Payment">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Bill">
                    <Setter Property="Background" Value="#ECFDF5"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="SectionTab" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B4332"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D8F3DC"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#2D6A4F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Reports &amp; Analytics" FontSize="22" FontWeight="Bold" Foreground="#1B4332"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Border Background="#ECFDF5" CornerRadius="12" Padding="10,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding PeriodLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
                    </Border>
                    <TextBlock Text="{Binding SectionDescription}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,0"/>
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,0"/>
                <Button Content="Print" Command="{Binding PrintCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,0"/>
                <Button Content="Save PDF" Command="{Binding SavePdfCommand}" Style="{DynamicResource PrimaryButton}" Padding="12,4" Height="28" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="12,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="118" Margin="0,0,10,0">
                    <TextBlock Text="Period" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding DatePresets}" SelectedItem="{Binding SelectedPreset}" Style="{StaticResource CompactCombo}"/>
                </StackPanel>
                <StackPanel Width="118" Margin="0,0,10,0">
                    <TextBlock Text="From" Style="{StaticResource FilterLabel}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Height="28" IsEnabled="{Binding IsCustomRange}" FontSize="12"/>
                </StackPanel>
                <StackPanel Width="118" Margin="0,0,10,0">
                    <TextBlock Text="To" Style="{StaticResource FilterLabel}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Height="28" IsEnabled="{Binding IsCustomRange}" FontSize="12"/>
                </StackPanel>
                <StackPanel Width="96" Margin="0,0,10,0">
                    <TextBlock Text="Payment" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding SelectedPayment}" Style="{StaticResource CompactCombo}"/>
                </StackPanel>
                <StackPanel Width="150" Margin="0,0,10,0">
                    <TextBlock Text="Online account" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding SelectedAccountFilter}"
                              DisplayMemberPath="DisplayName" Style="{StaticResource CompactCombo}"
                              ToolTip="{Binding SelectedAccountFilter.DisplayName}"/>
                </StackPanel>
                <StackPanel Width="220" Margin="0,0,10,0">
                    <TextBlock Text="Search" Style="{StaticResource FilterLabel}"/>
                    <Grid>
                        <TextBox x:Name="ReportSearchBox"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Style="{DynamicResource ModernTextBox}"
                                 Height="28" FontSize="12" Padding="8,3" VerticalContentAlignment="Center"
                                 TextChanged="ReportSearchBox_TextChanged"
                                 ToolTip="Type a customer name to filter bills, for example Talha."/>
                        <TextBlock Text="Bill, customer, item…"
                                   IsHitTestVisible="False"
                                   FontSize="12" Foreground="#94A3B8"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </StackPanel>
                <Button Content="Reset" Command="{Binding ResetFiltersCommand}" Style="{StaticResource ToolbarButton}" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="10" Padding="6" Margin="0,0,0,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Overview" GroupName="ReportSections" Style="{StaticResource SectionTab}" IsChecked="{Binding ShowOverview, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Overview"/>
                <RadioButton Content="Sales" GroupName="ReportSections" Style="{StaticResource SectionTab}" IsChecked="{Binding ShowSales, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Sales"/>
                <RadioButton Content="Items" GroupName="ReportSections" Style="{StaticResource SectionTab}" IsChecked="{Binding ShowItems, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Items"/>
                <RadioButton Content="Bills" GroupName="ReportSections" Style="{StaticResource SectionTab}" IsChecked="{Binding ShowBills, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Bills"/>
                <RadioButton Content="Customers" GroupName="ReportSections" Style="{StaticResource SectionTab}" IsChecked="{Binding ShowCustomers, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Customers"/>
                <RadioButton Content="Payments" GroupName="ReportSections" Style="{StaticResource SectionTab}" IsChecked="{Binding ShowPayments, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Payments"/>
                <RadioButton Content="Accounts" GroupName="ReportSections" Style="{StaticResource SectionTab}" IsChecked="{Binding ShowAccounts, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Accounts"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                    <Border Background="#FEF3C7" CornerRadius="10" Padding="12,9" Margin="0,0,0,12"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#92400E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- KPI cards — same card format as Dashboard, values for selected report range -->
                    <UniformGrid Columns="6" Margin="0,0,-12,0">

                        <Border Style="{DynamicResource CardBorder}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="&#x1F4B0;" FontSize="22" Margin="0,0,0,4"/>
                                <TextBlock Text="Total Sales" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock Text="کل فروخت" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="{DynamicResource UrduFont}" Margin="0,2,0,4"/>
                                <TextBlock Text="{Binding Kpis.GrossSalesDisplay}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorder}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="&#x1F4B3;" FontSize="22" Margin="0,0,0,4"/>
                                <TextBlock Text="Customer Credits" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock Text="  سابقہ بنام" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="{DynamicResource UrduFont}" Margin="0,2,0,4"/>
                                <TextBlock Text="{Binding Kpis.OutstandingCreditDisplay}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorder}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="&#x1F4B5;" FontSize="22" Margin="0,0,0,4"/>
                                <TextBlock Text="Cash Received" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock Text="نقد وصولی " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="{DynamicResource UrduFont}" Margin="0,2,0,4"/>
                                <TextBlock Text="{Binding Kpis.CashReceivedDisplay}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorder}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="&#x1F310;" FontSize="22" Margin="0,0,0,4"/>
                                <TextBlock Text="Online Payments" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock Text="آن لائن وصولی" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="{DynamicResource UrduFont}" Margin="0,2,0,4"/>
                                <TextBlock Text="{Binding Kpis.OnlineReceivedDisplay}" FontSize="18" FontWeight="Bold"
                                           Foreground="#0EA5E9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorder}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="&#x1F4BC;" FontSize="22" Margin="0,0,0,4"/>
                                <TextBlock Text="Total Received" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock Text=" کل وصولی" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="{DynamicResource UrduFont}" Margin="0,2,0,4"/>
                                <TextBlock Text="{Binding Kpis.TotalReceivedDisplay}" FontSize="18" FontWeight="Bold"
                                           Foreground="#10B981" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorder}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="&#x1F4B8;" FontSize="22" Margin="0,0,0,4"/>
                                <TextBlock Text="Discount" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock Text="رعایت" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="{DynamicResource UrduFont}" Margin="0,2,0,4"/>
                                <TextBlock Text="{Binding Kpis.DiscountDisplay}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Visibility="{Binding ShowStackedLayout, Converter={StaticResource BoolToVis}}"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly"
                          Padding="0,0,8,8">
                <StackPanel>
                    <!-- Overview -->
                    <Grid Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="280"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="280"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding TrendChartTitle}" FontWeight="Bold" FontSize="13" Foreground="#1B4332"/>
                                    <TextBlock Text="{Binding TrendChartHint}" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                                <controls:BarChartControl DataSource="{Binding MonthlyRevenueChart}" BarColor="#1B4332" ChartKind="Line" MinHeight="200"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ChartCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Payment mix" FontWeight="Bold" FontSize="13" Foreground="#1B4332" Margin="0,0,0,6"/>
                                <controls:BarChartControl DataSource="{Binding PaymentChart}" ChartKind="Donut" MinHeight="200"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChartCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding QuantityChartTitle}" FontWeight="Bold" FontSize="13" Foreground="#1B4332"/>
                                </StackPanel>
                                <controls:BarChartControl DataSource="{Binding QuantityChart}" BarColor="#0F766E" ChartKind="Line" MinHeight="200"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ChartCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Top items by revenue" FontWeight="Bold" FontSize="13" Foreground="#1B4332" Margin="0,0,0,6"/>
                                <controls:BarChartControl DataSource="{Binding TopRevenueChart}" BarColor="#C2410C" ChartKind="Horizontal" MinHeight="200"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Sales -->
                    <StackPanel Visibility="{Binding ShowSales, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource ChartCard}" Height="280" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Daily net sales" FontWeight="Bold" FontSize="14" Foreground="#1B4332"/>
                                    <TextBlock Text="{Binding DailySalesHint}" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                                <controls:BarChartControl DataSource="{Binding DailySalesChart}" BarColor="#1B4332" ChartKind="Line" MinHeight="220"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{DynamicResource CardBorder}" Padding="0" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Monthly summary" FontWeight="Bold" FontSize="14" Foreground="#1B4332" Margin="16,12,16,8"/>
                                <DataGrid ItemsSource="{Binding MonthlyReport}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Style="{StaticResource ReportGrid}" Height="200" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Month" Binding="{Binding MonthLabel}" Width="Auto" MinWidth="140"/>
                                        <DataGridTextColumn Header="Revenue" Binding="{Binding RevenueDisplay}" Width="Auto" MinWidth="120"/>
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityDisplay}" Width="Auto" MinWidth="100"/>
                                        <DataGridTextColumn Header="Bills" Binding="{Binding Bills}" Width="Auto" MinWidth="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Style="{DynamicResource CardBorder}" Padding="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Bills in period" FontWeight="Bold" FontSize="14" Foreground="#1B4332" Margin="16,12,16,8"/>
                                <DataGrid ItemsSource="{Binding BillsView}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Style="{StaticResource ReportGrid}" RowStyle="{StaticResource BillRowStyle}" Height="300" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Bill" Binding="{Binding InvoiceDisplay}" Width="Auto" MinWidth="90"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding ReportBillKind}" Width="Auto" MinWidth="90"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding BillDateTime, StringFormat='dd MMM yyyy HH:mm'}" Width="Auto" MinWidth="150"/>
                                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerDisplayName}" Width="Auto" MinWidth="160"/>
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding SubTotal, StringFormat='Rs.{0:N0}'}" Width="Auto" MinWidth="110"/>
                                        <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat='Rs.{0:N0}'}" Width="Auto" MinWidth="110"/>
                                        <DataGridTextColumn Header="Net" Binding="{Binding GrandTotal, StringFormat='Rs.{0:N0}'}" Width="Auto" MinWidth="110"/>
                                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentDisplayText}" Width="Auto" MinWidth="160"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

                    <!-- Items -->
                    <Grid Grid.Row="1" Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource CardBorder}" Padding="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                                    <TextBlock Text="Item sales" FontWeight="Bold" FontSize="14" Foreground="#1B4332"/>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding ItemReport}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Style="{StaticResource ReportGrid}" CanUserSortColumns="True" BorderThickness="0"
                                          MouseDoubleClick="ItemGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item" Binding="{Binding DisplayName}" Width="Auto" MinWidth="180"/>
                                        <DataGridTextColumn Header="Quantity Sold" Binding="{Binding QuantityDisplay}" Width="Auto" MinWidth="120"/>
                                        <DataGridTextColumn Header="Revenue" Binding="{Binding RevenueDisplay}" Width="Auto" MinWidth="120"/>
                                        <DataGridTextColumn Header="Bills" Binding="{Binding BillCount}" Width="Auto" MinWidth="80"/>
                                        <DataGridTextColumn Header="Sales Lines" Binding="{Binding LineCount}" Width="Auto" MinWidth="110"/>
                                        <DataGridTemplateColumn Header="" Width="Auto" MinWidth="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Details" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="10,4" Style="{DynamicResource SecondaryButton}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ChartCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Top 5 best selling" FontWeight="Bold" FontSize="14" Foreground="#1B4332"/>
                                    <TextBlock FontSize="11" Foreground="#94A3B8">
                                        <Run Text="{Binding SelectedPreset, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding PeriodLabel, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="By quantity sold in the selected range" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                                <controls:BarChartControl DataSource="{Binding TopQtyChart}" BarColor="#1B4332" ChartKind="Horizontal" MinHeight="240"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Bills -->
                    <Border Grid.Row="1" Visibility="{Binding ShowBills, Converter={StaticResource BoolToVis}}" Style="{DynamicResource CardBorder}" Padding="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                                <TextBlock Text="Bills" FontWeight="Bold" FontSize="14" Foreground="#1B4332"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Width="10" Height="10" Background="#ECFDF5" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                                    <TextBlock Text="Paid" FontSize="11" Foreground="#166534" Margin="0,0,14,0"/>
                                    <Border Width="10" Height="10" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                                    <TextBlock Text="Credit" FontSize="11" Foreground="#92400E" Margin="0,0,14,0"/>
                                    <Border Width="10" Height="10" Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                                </StackPanel>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding BillsView}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource ReportGrid}" RowStyle="{StaticResource BillRowStyle}"
                                      ColumnHeaderStyle="{StaticResource BillsGridHeader}"
                                      CellStyle="{DynamicResource ModernDataGridCell}"
                                      ColumnHeaderHeight="52"
                                      CanUserResizeColumns="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding BillDateTime, StringFormat='dd/MM/yy HH:mm'}"
                                                        Width="Auto" MinWidth="130">
                                        <DataGridTextColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="DateTime" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="تاریخ و وقت" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding InvoiceDisplay}" Width="Auto" MinWidth="100">
                                        <DataGridTextColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Invoice" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="بل نمبر" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding CustomerDisplayName}" Width="Auto" MinWidth="160">
                                        <DataGridTextColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Customer Name" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="گاہک" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding SubTotal, StringFormat='Rs. {0:N0}'}" Width="Auto" MinWidth="110">
                                        <DataGridTextColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Subtotal" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="ذیلی کل" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource AmountCellText}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding PreviousBalance, StringFormat='Rs. {0:N0}'}" Width="Auto" MinWidth="130">
                                        <DataGridTextColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Previous Credit" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="سابقہ بنام" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource AmountCellText}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding RowTotalBanam, StringFormat='Rs. {0:N0}'}" Width="Auto" MinWidth="110">
                                        <DataGridTextColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Total" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="کل بنام" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource AmountCellText}">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding AppliedReceived, StringFormat='Rs. {0:N0}'}" Width="Auto" MinWidth="130">
                                        <DataGridTextColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Received" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="وصول شدہ رقم" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource AmountCellText}">
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Credit, StringFormat='Rs. {0:N0}'}" Width="Auto" MinWidth="130">
                                        <DataGridTextColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Pending Credit" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="بقیہ رقم" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource AmountCellText}">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPendingCredit}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="Auto" MinWidth="110">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Status" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="حالت" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="14" Padding="12,5" HorizontalAlignment="Center" Margin="4,0"
                                                        Background="{Binding ReportStatusBackground}"
                                                        BorderBrush="{Binding ReportStatusBorderBrush}"
                                                        BorderThickness="1.2">
                                                    <TextBlock Text="{Binding ReportStatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding ReportStatusForeground}" HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding PaymentDisplayText}" Width="Auto" MinWidth="160">
                                        <DataGridTextColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Payment" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="ادائیگی" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReportCellText}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="Auto" MinWidth="90" CellStyle="{StaticResource ActionGridCell}">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="View" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="دیکھیں" FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="White" FontFamily="{DynamicResource UrduFont}"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="View"
                                                        Padding="12,5" Margin="4,0" FontSize="11" FontWeight="SemiBold"
                                                        Background="#E0F2FE" Foreground="#075985"
                                                        BorderBrush="#7DD3FC" BorderThickness="1" Cursor="Hand" Focusable="False"
                                                        Command="{Binding DataContext.ViewBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="10"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Customers -->
                    <Border Grid.Row="1" Visibility="{Binding ShowCustomers, Converter={StaticResource BoolToVis}}" Style="{DynamicResource CardBorder}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Customers" FontWeight="Bold" FontSize="14" Foreground="#1B4332" Margin="16,12,16,8"/>
                            <DataGrid ItemsSource="{Binding CustomerReport}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource ReportGrid}" CanUserSortColumns="True" BorderThickness="0"
                                      MouseDoubleClick="CustomerGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Customer گاہک" Binding="{Binding CustomerName}" Width="Auto" MinWidth="180"/>
                                    <DataGridTextColumn Header="Bills بل کی تعداد" Binding="{Binding BillCount}" Width="Auto" MinWidth="120"/>
                                    <DataGridTextColumn Header="Purchases فروخت" Binding="{Binding PurchasesDisplay}" Width="Auto" MinWidth="140"/>
                                    <DataGridTextColumn Header="Payments ادائیگی" Binding="{Binding PaymentsDisplay}" Width="Auto" MinWidth="140"/>
                                    <DataGridTextColumn Header="Credit Due بقیہ رقم" Binding="{Binding OutstandingDisplay}" Width="Auto" MinWidth="150"/>
                                    <DataGridTextColumn Header="Last Transaction آخری ٹرانزیکشن" Binding="{Binding LastTransactionDisplay}" Width="Auto" MinWidth="200"/>
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="History" Command="{Binding DataContext.OpenCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="10,4" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0"/>
                                                    <Button Content="Ledger" Command="{Binding DataContext.OpenLedgerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="10,4" Style="{DynamicResource SecondaryButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Payments -->
                    <Grid Grid.Row="1" Visibility="{Binding ShowPayments, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ChartCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Payment mix" FontWeight="Bold" FontSize="14" Foreground="#1B4332" Margin="0,0,0,8"/>
                                <controls:BarChartControl DataSource="{Binding PaymentChart}" ChartKind="Donut" MinHeight="220"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{DynamicResource CardBorder}" Padding="0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="12,10,12,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Bills &amp; payments" FontWeight="Bold" FontSize="14" Foreground="#1B4332" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <Border Width="12" Height="12" Background="#ECFDF5" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bill" FontSize="11" Foreground="#166534" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Width="12" Height="12" Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Payment" FontSize="11" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Show" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding ReceiptKindOptions}" SelectedItem="{Binding SelectedReceiptKind}"
                                                  Style="{StaticResource CompactCombo}" Width="130"/>
                                    </StackPanel>
                                </Grid>
                                <DataGrid ItemsSource="{Binding ReceiptLedger}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Style="{StaticResource ReportGrid}" RowStyle="{StaticResource ReceiptRowStyle}" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Type" Width="Auto" MinWidth="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding TypeChipBackground}" BorderBrush="{Binding TypeChipBorder}"
                                                            BorderThickness="1" CornerRadius="8" Padding="8,2" HorizontalAlignment="Center" Margin="4,2">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding TypeChipForeground}" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceDisplay}" Width="Auto" MinWidth="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="Auto" MinWidth="160"/>
                                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="Auto" MinWidth="160"/>
                                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="Auto" MinWidth="140"/>
                                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedDisplay}" Width="Auto" MinWidth="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Accounts -->
                    <Grid Grid.Row="1" Visibility="{Binding ShowAccounts, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource CardBorder}" Padding="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Online account receipts" FontWeight="Bold" FontSize="14" Foreground="#1B4332" Margin="16,12,16,8"/>
                                <DataGrid ItemsSource="{Binding AccountReport}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Style="{StaticResource ReportGrid}" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="Auto" MinWidth="180"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="Auto" MinWidth="100"/>
                                        <DataGridTextColumn Header="Transactions" Binding="{Binding TransactionCount}" Width="Auto" MinWidth="120"/>
                                        <DataGridTextColumn Header="Amount Received" Binding="{Binding AmountDisplay}" Width="Auto" MinWidth="140"/>
                                        <DataGridTemplateColumn Header="" Width="Auto" MinWidth="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Details" Command="{Binding DataContext.OpenAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="10,4" Style="{DynamicResource SecondaryButton}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ChartCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Received by account" FontWeight="Bold" FontSize="14" Foreground="#1B4332"/>
                                    <TextBlock FontSize="11" Foreground="#94A3B8">
                                        <Run Text="{Binding SelectedPreset, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding PeriodLabel, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="Amount received per online account" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                                <controls:BarChartControl DataSource="{Binding AccountReceiptChart}" BarColor="#0284C7" ChartKind="Horizontal" MinHeight="240"/>
                            </DockPanel>
                        </Border>
                    </Grid>
        </Grid>

        <!-- Item drill-down -->
        <Border Grid.RowSpan="4" Background="#99000000" Visibility="{Binding IsItemDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorder}" Width="780" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedItem.DisplayName}" FontSize="20" FontWeight="Bold" Foreground="#1B4332"/>
                            <TextBlock FontSize="13" Foreground="#64748B" Margin="0,4,0,0">
                                <Run Text="Quantity sold "/><Run Text="{Binding SelectedItem.QuantityDisplay, Mode=OneWay}"/>
                                <Run Text="  ·  Revenue "/><Run Text="{Binding SelectedItem.RevenueDisplay, Mode=OneWay}"/>
                                <Run Text="  ·  Bills "/><Run Text="{Binding SelectedItem.BillCount, Mode=OneWay}"/>
                                <Run Text="  ·  Lines "/><Run Text="{Binding SelectedItem.LineCount, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Content="Close" Command="{Binding CloseItemCommand}" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="14,8"/>
                    </Grid>
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ItemDetailFooter}" FontWeight="SemiBold" FontSize="13" Foreground="#1B4332"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding ItemLines}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ReportGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bill" Binding="{Binding BillId}" Width="Auto" MinWidth="100"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="Auto" MinWidth="160"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding QuantityDisplay}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding PriceDisplay}" Width="Auto" MinWidth="100"/>
                            <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotalDisplay}" Width="Auto" MinWidth="120"/>
                            <DataGridTemplateColumn Width="Auto" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Bill" Command="{Binding DataContext.OpenLineBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="8,4" Style="{DynamicResource SecondaryButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>

        <!-- Account drill-down -->
        <Border Grid.RowSpan="4" Background="#99000000" Visibility="{Binding IsAccountDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorder}" Width="840" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedAccountRow.AccountName}" FontSize="20" FontWeight="Bold" Foreground="#1B4332"/>
                            <TextBlock Text="{Binding SelectedAccountRow.AmountDisplay, StringFormat='Received {0}'}" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="Close" Command="{Binding CloseAccountCommand}" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Padding="14,8"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding AccountBills}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ReportGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bill" Binding="{Binding InvoiceDisplay}" Width="Auto" MinWidth="100"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding BillDateTime, StringFormat='dd MMM yyyy HH:mm'}" Width="Auto" MinWidth="160"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerDisplayName}" Width="Auto" MinWidth="160"/>
                            <DataGridTextColumn Header="Received" Binding="{Binding AppliedReceived, StringFormat='Rs.{0:N0}'}" Width="Auto" MinWidth="120"/>
                            <DataGridTemplateColumn Width="Auto" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View" Command="{Binding DataContext.ViewBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" Style="{DynamicResource SecondaryButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>

        <!-- Customer drill-down -->
        <Border Grid.RowSpan="4" Background="#99000000" Visibility="{Binding IsCustomerDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorder}" Width="880" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCustomer.CustomerName}" FontSize="20" FontWeight="Bold" Foreground="#1B4332"/>
                            <TextBlock FontSize="13" Foreground="#64748B" Margin="0,4,0,0">
                                <Run Text="Purchases "/><Run Text="{Binding SelectedCustomer.PurchasesDisplay, Mode=OneWay}"/>
                                <Run Text="  ·  Payments "/><Run Text="{Binding SelectedCustomer.PaymentsDisplay, Mode=OneWay}"/>
                                <Run Text="  ·  Outstanding "/><Run Text="{Binding SelectedCustomer.OutstandingDisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Open ledger" Command="{Binding OpenLedgerCommand}" Style="{DynamicResource PrimaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                            <Button Content="Close" Command="{Binding CloseCustomerCommand}" Style="{DynamicResource SecondaryButton}" Padding="14,8"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding CustomerBills}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ReportGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bill" Binding="{Binding InvoiceDisplay}" Width="Auto" MinWidth="100"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding BillDateTime, StringFormat='dd MMM yyyy HH:mm'}" Width="Auto" MinWidth="160"/>
                            <DataGridTextColumn Header="Net" Binding="{Binding GrandTotal, StringFormat='Rs.{0:N0}'}" Width="Auto" MinWidth="110"/>
                            <DataGridTextColumn Header="Received" Binding="{Binding AppliedReceived, StringFormat='Rs.{0:N0}'}" Width="Auto" MinWidth="110"/>
                            <DataGridTextColumn Header="Payment" Binding="{Binding PaymentDisplayText}" Width="Auto" MinWidth="160"/>
                            <DataGridTemplateColumn Width="Auto" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View" Command="{Binding DataContext.ViewBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" Style="{DynamicResource SecondaryButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>

        <!-- Bill preview -->
        <Border Grid.RowSpan="4" Background="#99000000" Visibility="{Binding IsBillDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" Width="420" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Close" Command="{Binding CloseBillDetailCommand}" HorizontalAlignment="Right" Margin="10" Style="{DynamicResource SecondaryButton}" Padding="14,8"/>
                    <controls:BillReceiptControl Bill="{Binding SelectedHistoryBill}"/>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
