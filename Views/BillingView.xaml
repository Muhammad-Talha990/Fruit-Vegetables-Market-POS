<UserControl x:Class="FruitVegetableMarketPOS.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FruitVegetableMarketPOS.Converters"
             xmlns:helpers="clr-namespace:FruitVegetableMarketPOS.Helpers"
             xmlns:controls="clr-namespace:FruitVegetableMarketPOS.Views.Controls"
             Background="#F3F6F4" FontFamily="Segoe UI, Nirmala UI"
             MinWidth="900">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:InverseBoolConverter x:Key="InvBool"/>
        <converters:CountToVisibilityConverter x:Key="CountToVis"/>
        <converters:CountToVisibilityConverter x:Key="InverseCountToVis" Inverse="True"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:NumericToVisibilityConverter x:Key="NumToVis"/>
        <converters:StatusColorConverter x:Key="StatusColorConverter"/>
        <converters:FruitIconConverter x:Key="FruitIcon"/>

        <!-- Shows Tag as gray hint text when the box is empty -->
        <Style x:Key="HintTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#F8FAF8"/>
            <Setter Property="BorderBrush" Value="#D0D8D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="helpers:FocusHelper.SelectAllOnFocus" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Height="{TemplateBinding Height}" MinHeight="{TemplateBinding MinHeight}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}"
                                           Foreground="#9AA89E" FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Margin="1,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatChip" TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact combo used in Add Today row -->
        <Style x:Key="CompactCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Balanced cards: stretch in a 7-column grid; ~3 rows fit before scroll -->
        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Height" Value="128"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="3,3,3,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#43A047"/>
                    <Setter Property="Background" Value="#FAFFF9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GreenAction" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrangeAction" TargetType="Button">
            <Setter Property="Background" Value="#EF6C00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F57C00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4B6354"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,4,6,4" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI strip (compact) -->
        <Border Grid.Row="0" Background="#1B4332" CornerRadius="8" Padding="8,4" Margin="0,0,0,4">
            <UniformGrid Columns="6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Sales" FontSize="9" Foreground="#95D5B2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatTotalSales, StringFormat='Rs.{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Returns" FontSize="9" Foreground="#95D5B2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatReturns, StringFormat='Rs.{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#FFAB91" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Credit Due" FontSize="9" Foreground="#95D5B2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatCredit, StringFormat='Rs.{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#EF9A9A" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Recovered" FontSize="9" Foreground="#95D5B2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatRecoveredCredit, StringFormat='Rs.{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#CE93D8" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Cash Drawer" FontSize="9" Foreground="#95D5B2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatCashInDrawer, StringFormat='Rs.{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#A5D6A7" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Online" FontSize="9" Foreground="#95D5B2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatOnlinePayments, StringFormat='Rs.{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#81D4FA" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Catalog -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PMC" FontSize="14" FontWeight="Bold" Foreground="#1B4332" Margin="0,0,6,0"/>
                        <TextBlock Text="Pak Madinah Commission Agents" FontSize="11" FontWeight="SemiBold" Foreground="#2D6A4F" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BusinessDateDisplay, StringFormat='  ·  {0}'}" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Open bill tabs: switch · close · + new -->
                <Border DockPanel.Dock="Top" Background="#F4F9F5" CornerRadius="8" Padding="4,3" Margin="0,0,0,4"
                        BorderBrush="#D8E8D8" BorderThickness="1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+" Command="{Binding AddTabCommand}"
                                Style="{StaticResource GreenAction}" Padding="10,2" FontSize="14" FontWeight="Bold"
                                ToolTip="New bill tab · نیا بل" MinWidth="30" Height="24" Margin="5,0,0,0"
                                VerticalAlignment="Center"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,5,0" CornerRadius="6" Padding="0" Cursor="Hand"
                                                Height="24" VerticalAlignment="Center">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Setter Property="BorderBrush" Value="#C8E6C9"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#2E7D32"/>
                                                            <Setter Property="BorderBrush" Value="#1B5E20"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" Margin="8,1,4,1">
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="11" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1B5E20"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Content="×" FontSize="13" FontWeight="Bold" Padding="5,0"
                                                        Cursor="Hand" VerticalAlignment="Center"
                                                        ToolTip="Close this bill tab"
                                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.CanCloseTabs, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFCDD2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Daily setup: ID + item + type count → set prices → Add -->
                <Border DockPanel.Dock="Top" Background="White" CornerRadius="8" Padding="6,4" Margin="0,0,0,4"
                        BorderBrush="#D8E8D8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Add item to today's selling list · آج کی فہرست میں نیا آئٹم شامل کریں"
                                   FontSize="9" FontWeight="SemiBold" Foreground="#4B6354" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DailySetupItemIdText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HintTextBox}"
                                     Tag="Item ID" ToolTip="Enter item code shown on card (#1, #2, #3…)"
                                     Margin="0,0,5,0"
                                     helpers:FocusHelper.NumericOnly="True"
                                     helpers:FocusHelper.SelectAllOnFocus="True"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AllMasterItems}"
                                      SelectedItem="{Binding DailySetupSelectedItem, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayLabel" IsEditable="False"
                                      Style="{StaticResource CompactCombo}"
                                      ToolTip="Pick item name — or enter a valid Item ID"
                                      Margin="0,0,5,0"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding DailyTypeCountOptions}"
                                      SelectedItem="{Binding SelectedDailyTypeCountOption, Mode=TwoWay}"
                                      DisplayMemberPath="Label" IsEditable="False"
                                      Style="{StaticResource CompactCombo}"
                                      ToolTip="Type count — select 1 … 10"
                                      Margin="0,0,5,0"/>
                            <Button Grid.Column="3" Content="Clear" ToolTip="Clear item ID, type count, and prices"
                                    Command="{Binding ClearDailySetupCommand}" Style="{StaticResource OrangeAction}"
                                    Padding="8,2" FontSize="10" FontWeight="SemiBold" Height="24" MinHeight="24"/>
                        </Grid>

                        <!-- Type prices — 5-column compact grid (max Rs.10,000) -->
                        <StackPanel Margin="0,4,0,0" Visibility="{Binding HasDailyTypePriceRows, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Set price · قیمت مقرر کریں" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#4B6354" Margin="0,0,0,3"/>
                            <ItemsControl ItemsSource="{Binding DailyTypePriceRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,4,4" Padding="4,3" Background="#F8FAF8"
                                                BorderBrush="#D8E8D8" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="8" FontWeight="SemiBold"
                                                           Foreground="#1B4332" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource HintTextBox}"
                                                         Tag="Price"
                                                         helpers:FocusHelper.NumericOnly="True"
                                                         helpers:FocusHelper.SelectAllOnFocus="True"/>
                                                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource HintTextBox}"
                                                         Tag="Note"
                                                         ToolTip="Optional note for this type"
                                                         Margin="0,3,0,0"
                                                         MaxLength="80"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="✓ Add" Style="{StaticResource GreenAction}"
                                    ToolTip="Add this item to today's menu (once only)"
                                    Command="{Binding AddDailyItemCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,0" Padding="10,3" FontSize="11" Height="26"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Search + categories -->
                <Border DockPanel.Dock="Top" Background="White" CornerRadius="8" Padding="6,3" Margin="0,0,0,4"
                        BorderBrush="#D8E8D8" BorderThickness="1"
                        Opacity="{Binding MenuOpacity}"
                        IsEnabled="{Binding IsBillingLocked, Converter={StaticResource InvBool}}">
                    <StackPanel>
                        <TextBox Text="{Binding ProductSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource HintTextBox}"
                                 Tag="Search products by name / نام سے تلاش کریں..."
                                 ToolTip="Filter the product cards below by English or Urdu name"
                                 Margin="0,0,0,3"/>
                        <ItemsControl ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource CatChip}"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Product grid — even 7-column layout, 3 full rows before scroll -->
                <Border Background="#F7FAF7" CornerRadius="8" Padding="8" BorderBrush="#D8E8D8" BorderThickness="1">
                    <Grid>
                        <Grid Opacity="{Binding MenuOpacity}"
                              IsEnabled="{Binding IsBillingLocked, Converter={StaticResource InvBool}}"
                              Visibility="{Binding IsNewDaySetupActive, Converter={StaticResource InvBoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,2,4,2"
                                          CanContentScroll="False"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TodayProducts}"
                                              HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ProductCard}" Opacity="{Binding CardOpacity}">
                                                <Grid>
                                                    <Grid.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Grid.InputBindings>

                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,0,0,0" Width="20" Height="20" Padding="0" Cursor="Hand"
                                                            Content="{Binding ToggleGlyph}" FontSize="10" FontWeight="Bold"
                                                            Foreground="#FFFFFF" Background="{Binding ToggleBrush}"
                                                            ToolTip="{Binding ToggleToolTip}"
                                                            Panel.ZIndex="2"
                                                            Command="{Binding DataContext.ToggleTodayAvailabilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <StackPanel VerticalAlignment="Center" Margin="2,2,2,0">
                                                        <Border Height="58" MaxWidth="120" CornerRadius="8" Margin="0,0,0,4"
                                                                HorizontalAlignment="Stretch" ClipToBounds="True"
                                                                Background="#FFFFFF">
                                                            <Grid>
                                                                <Image Source="{Binding PhotoSource}"
                                                                       Stretch="Uniform" MaxHeight="54"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"/>
                                                                <Image Source="{Binding IconKey, Converter={StaticResource FruitIcon}}"
                                                                       Stretch="Uniform" Width="48" Height="48"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Visibility="{Binding HasPhoto, Converter={StaticResource InvBoolToVis}}"/>
                                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                        Margin="4,4,0,0" Background="#1B4332" CornerRadius="4"
                                                                        Padding="5,1" Panel.ZIndex="1">
                                                                    <TextBlock Text="{Binding CodeDisplay}" Foreground="White"
                                                                               FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12"
                                                                   Foreground="#1B4332" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Margin="2,0,2,1"/>
                                                        <TextBlock Text="{Binding DisplayUrdu}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="#2D6A4F" TextAlignment="Center" FlowDirection="RightToLeft"
                                                                   TextTrimming="CharacterEllipsis" Margin="2,0,2,4"
                                                                   Visibility="{Binding DisplayUrdu, Converter={StaticResource StringToVis}}"/>
                                                        <Button Content="Update" FontSize="10" FontWeight="SemiBold"
                                                                Padding="10,3" HorizontalAlignment="Stretch" Cursor="Hand"
                                                                Height="24" MinHeight="24" Margin="4,0,4,0"
                                                                ToolTip="Open dialog to update types / prices"
                                                                Style="{StaticResource OrangeAction}"
                                                                Command="{Binding DataContext.UpdateTodayProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding TodayProducts.Count, Converter={StaticResource InverseCountToVis}}">
                                <TextBlock Text="آج کی اشیاء شامل کریں" FontSize="18" FontWeight="Bold" Foreground="#2D6A4F" HorizontalAlignment="Center"/>
                                <TextBlock Text="Use + Add Today above to show products here."
                                           FontSize="12" Foreground="#6B7280" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Inactive customer lock overlay on product menu -->
                        <Border Background="#CCF8FAF8" CornerRadius="8" Panel.ZIndex="20"
                                Visibility="{Binding InactiveCustomerBannerVisible, Converter={StaticResource BoolToVis}}"
                                IsHitTestVisible="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                <TextBlock Text="{Binding InactiveCustomerMessageEnText}"
                                           FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding InactiveCustomerMessageUrText}"
                                           FontSize="18" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" FlowDirection="RightToLeft"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="Reactivate this customer in Customer Management to bill."
                                           FontSize="12" Foreground="#6B7280" Margin="0,12,0,0"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- New day: Continue previous OR Refresh (start empty) -->
                        <Border Background="#F7FBF7" CornerRadius="10" Padding="16"
                                Panel.ZIndex="30"
                                Visibility="{Binding IsNewDayPromptVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Center">
                                <TextBlock Text="New day · نیا دن" FontSize="20" FontWeight="Bold"
                                           Foreground="#1B4332" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PreviousMenuDateDisplay, StringFormat='Previous menu date: {0}'}"
                                           FontSize="12" Foreground="#6B7280" Margin="0,6,0,14"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Continue with yesterday's items, or Refresh to clear and add today's list manually."
                                           FontSize="13" Foreground="#4B6354" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Continue with previous items · پچھلی اشیاء"
                                            Command="{Binding ShowContinuePreviousCommand}"
                                            Style="{StaticResource GreenAction}"
                                            Padding="16,12" FontSize="13" Margin="0,0,10,0"/>
                                    <Button Content="Refresh · تازہ شروع"
                                            Command="{Binding NewDayRefreshCommand}"
                                            Style="{StaticResource OrangeAction}"
                                            Padding="16,12" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Pick which previous-day items to keep for today -->
                        <Grid Panel.ZIndex="30"
                              Visibility="{Binding IsPreviousDayPickerVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Select items for today · آج کی اشیاء منتخب کریں"
                                           FontSize="15" FontWeight="Bold" Foreground="#1B4332"/>
                                <TextBlock Text="{Binding PreviousMenuDateDisplay, StringFormat='From previous menu ({0}) — check the items you want.'}"
                                           FontSize="12" Foreground="#6B7280" Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Select all" Command="{Binding SelectAllPreviousCommand}"
                                            Style="{StaticResource GreenAction}" Padding="10,5" FontSize="11" Margin="0,0,8,0"/>
                                    <Button Content="Clear all" Command="{Binding ClearPreviousSelectionCommand}"
                                            Style="{StaticResource OrangeAction}" Padding="10,5" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding PreviousDayMenuItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAF8" BorderBrush="#D8E8D8" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          FontSize="13" Foreground="#1B4332"
                                                          VerticalContentAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"/>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Content="Back" Command="{Binding CancelPreviousPickerCommand}"
                                        Style="{StaticResource OrangeAction}" Padding="14,8" FontSize="12" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="Add selected to today · شامل کریں"
                                        Command="{Binding ConfirmPreviousSelectionCommand}"
                                        Style="{StaticResource GreenAction}" Padding="14,8" FontSize="12"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- RIGHT: Billing -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#D8E8D8" BorderThickness="1"
                    ClipToBounds="True">
                <Grid Margin="0" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="70"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E8F5E9" CornerRadius="12,12,0,0" Padding="10,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding InvoiceNumber, StringFormat='#{0}'}"
                                       FontSize="12" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock Text="Billing · بلنگ" FontSize="13" FontWeight="Bold" Foreground="#1B4332" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="8,8,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="+ Add Customer · گاہک درج کریں"
                                Style="{StaticResource GreenAction}"
                                ToolTip="Register a new customer"
                                Command="{Binding ToggleRegistrationCommand}"
                                Padding="14,10" FontSize="13" FontWeight="SemiBold"
                                HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Clear" Style="{StaticResource OrangeAction}"
                                ToolTip="Clear the whole bill / cart"
                                Command="{Binding ClearCartCommand}" Margin="6,0,0,0" Padding="14,10" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Customer -->
                    <Border Grid.Row="2" Margin="8,0,8,6" Background="#F7FAF7" CornerRadius="8" Padding="6">
                        <StackPanel>
                            <TextBlock Text="Customer · گاہک" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#4B6354" Margin="0,0,0,3"
                                       Visibility="{Binding HasSelectedCustomer, Converter={StaticResource InvBoolToVis}}"/>
                            <Grid Visibility="{Binding HasSelectedCustomer, Converter={StaticResource InvBoolToVis}}">
                                <TextBox x:Name="CustomerSearchBox"
                                         Text="{Binding CustomerSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource HintTextBox}"
                                         Tag="Phone required for walk-in / or search name"
                                         ToolTip="Type to search registered customers. Walk-in: enter 11-digit phone to place bill.">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Down" Command="{Binding NavigateSearchCommand}" CommandParameter="Down"/>
                                        <KeyBinding Key="Up" Command="{Binding NavigateSearchCommand}" CommandParameter="Up"/>
                                        <KeyBinding Key="Return" Command="{Binding SelectCustomerCommand}"/>
                                        <KeyBinding Key="Enter" Command="{Binding SelectCustomerCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Popup IsOpen="{Binding IsCustomerDropDownOpen, Mode=OneWay}"
                                       PlacementTarget="{Binding ElementName=CustomerSearchBox}"
                                       Placement="Bottom" StaysOpen="True"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="White" BorderBrush="#C8D8C8" BorderThickness="1"
                                            CornerRadius="8" MinWidth="{Binding ActualWidth, ElementName=CustomerSearchBox}"
                                            MaxHeight="180" Margin="0,2,0,0">
                                        <ListBox ItemsSource="{Binding CustomerSearchResults}"
                                                 SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                                 BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" Background="Transparent" Padding="0">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#E8F5E9"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#F1F8F1"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="10,8" Cursor="Hand">
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="12" Foreground="#1B4332"/>
                                                                <TextBlock Text="{Binding PrimaryPhone}" FontSize="10" Foreground="#607D68"/>
                                                            </StackPanel>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                    Background="#FEE2E2" CornerRadius="8" Padding="6,2"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}">
                                                                <TextBlock Text="Inactive" FontSize="9" FontWeight="SemiBold" Foreground="#DC2626"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Border CornerRadius="7" Padding="6,5"
                                    Visibility="{Binding IsRegisteredCustomerSelected, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomerInactive}" Value="True">
                                                <Setter Property="Background" Value="#9CA3AF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Click to view previous bills &amp; due amount"
                                            Command="{Binding OpenCustomerHistoryCommand}" Padding="0"
                                            IsEnabled="{Binding IsCustomerInactive, Converter={StaticResource InvBool}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedCustomer.Name}" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="11" TextDecorations="Underline"/>
                                            <TextBlock Text="{Binding SelectedCustomer.PrimaryPhone}" Foreground="#C8E6C9" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="Transparent" BorderThickness="0" Foreground="White"
                                            Command="{Binding ClearCustomerCommand}" Panel.ZIndex="1"/>
                                </Grid>
                            </Border>
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="7"
                                    Padding="8,6" Margin="0,4,0,0"
                                    Visibility="{Binding InactiveCustomerBannerVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding InactiveCustomerMessageEnText}" Foreground="#DC2626"
                                               FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding InactiveCustomerMessageUrText}" Foreground="#B91C1C"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"
                                               FlowDirection="RightToLeft" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBox Text="{Binding WalkInPhoneInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HintTextBox}"
                                     Tag="Enter walk-in phone number" MaxLength="11" Margin="0,4,0,0"
                                     ToolTip="Phone number for a walk-in customer (not registered)"
                                     helpers:FocusHelper.NumericOnly="True"
                                     helpers:FocusHelper.SelectAllOnFocus="True"
                                     Visibility="{Binding IsWalkInCustomerSelected, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding PendingCreditDisplay}" Foreground="#C62828" FontSize="10" Margin="0,4,0,0"
                                       Visibility="{Binding HasPendingCredit, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Cart list: Description | Qty | Unit price | Total -->
                    <Grid Grid.Row="3" Margin="4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="6,0,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Item · چیز" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="Qty · تعداد" FontSize="9" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Price · قیمت" FontSize="9" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Total · رقم" FontSize="9" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 IsEnabled="{Binding IsBillingLocked, Converter={StaticResource InvBool}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7FAF7" CornerRadius="6" Padding="6,5" Margin="2,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"
                                                           Foreground="#1B4332" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayName}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                     FontSize="11" FontWeight="SemiBold" Foreground="#1B4332"
                                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                     Background="Transparent" BorderThickness="0" Padding="2,0"
                                                     IsReadOnly="True" Cursor="Hand"
                                                     ToolTip="Double-click to type quantity (decimals OK) · تعداد"
                                                     helpers:FocusHelper.DecimalOnly="True"
                                                     helpers:FocusHelper.SelectAllOnFocus="True"
                                                     MouseDoubleClick="CartQty_MouseDoubleClick"
                                                     LostFocus="CartQty_LostFocus"
                                                     KeyDown="CartQty_KeyDown"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding UnitPrice, StringFormat='{}{0:N0}'}"
                                                       FontSize="11" Foreground="#4B6354"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TotalPrice, StringFormat='{}{0:N0}'}"
                                                       FontWeight="Bold" Foreground="#EF6C00" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Cart inactive banner -->
                        <Border Grid.Row="1" Background="#F8FAF8" Opacity="0.96"
                                Visibility="{Binding InactiveCustomerBannerVisible, Converter={StaticResource BoolToVis}}"
                                IsHitTestVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                <TextBlock Text="{Binding InactiveCustomerMessageEnText}"
                                           FontSize="13" FontWeight="Bold" Foreground="#DC2626"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding InactiveCustomerMessageUrText}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" FlowDirection="RightToLeft"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,2,8,4">
                        <Button Content="−" Command="{Binding DecreaseQuantityCommand}" Width="28" Height="24" Margin="0,0,4,0" FontSize="13"/>
                        <Button Content="+" Command="{Binding IncreaseQuantityCommand}" Width="28" Height="24" Margin="0,0,4,0"
                                Background="#2E7D32" Foreground="White" BorderThickness="0" FontSize="13"/>
                        <Button Content="Remove" Command="{Binding RemoveFromCartCommand}" Padding="6,3"
                                Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" FontSize="10"/>
                    </StackPanel>

                    <!-- Totals + actions (always visible, scrolls if needed) -->
                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="280" Padding="0,0,2,0">
                        <StackPanel Margin="8,0,8,8">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Subtotal · ذیلی رقم" FontSize="11" Foreground="#4B6354" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SubTotal, StringFormat='Rs.{0:N0}'}" HorizontalAlignment="Right"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Discount · رعایت" FontSize="10" Foreground="#4B6354" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="11"
                                             helpers:FocusHelper.DecimalOnly="True"
                                             helpers:FocusHelper.SelectAllOnFocus="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tax · ٹیکس" FontSize="10" Foreground="#4B6354" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding TaxText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="11"
                                             helpers:FocusHelper.DecimalOnly="True"
                                             helpers:FocusHelper.SelectAllOnFocus="True"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="#1B4332" CornerRadius="7" Padding="8,7" Margin="0,0,0,6">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Total · رقم" Foreground="#95D5B2" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding GrandTotal, StringFormat='Rs.{0:N0}'}"
                                               FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Payment · ادائیگی" FontSize="10" Foreground="#4B6354" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" Margin="0,0,0,6" Padding="4,3" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding ActiveAccounts}" SelectedItem="{Binding SelectedAccount}"
                                      DisplayMemberPath="DisplayName" Margin="0,0,0,6" Padding="4,3" FontSize="11"
                                      Visibility="{Binding IsOnlinePayment, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Amount Received · وصول رقم" FontSize="10" Foreground="#4B6354" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding CashReceivedText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" FontWeight="SemiBold" Padding="6,5" Margin="0,0,0,6"
                                     IsEnabled="{Binding IsAmountEditable}"
                                     helpers:FocusHelper.DecimalOnly="True"
                                     helpers:FocusHelper.SelectAllOnFocus="True"
                                     helpers:FocusHelper.FocusTrigger="{Binding FocusCashReceived}"/>
                            <Border CornerRadius="7" Padding="8,6" Margin="0,0,0,6" Background="{Binding ChangeDisplayBrush}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding ChangeDisplayLabel}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeAmountAbs, StringFormat='Rs.{0:N0}'}"
                                               Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                               Visibility="{Binding IsChangeAmountVisible, Converter={StaticResource BoolToVis}}"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Foreground="{Binding StatusMessage, Converter={StaticResource StatusColorConverter}}"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="1.35*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource OrangeAction}" Command="{Binding ClearCartCommand}"
                                        Content="Cancel" Padding="0,9" FontSize="12"/>
                                <Button Grid.Column="2" Command="{Binding OpenCartPreviewCommand}"
                                        Content="Preview" Padding="0,9" FontSize="12"
                                        ToolTip="View complete detailed bill before placing order"
                                        Background="#E8F5E9" Foreground="#1B4332" BorderBrush="#A5D6A7" BorderThickness="1"
                                        FontWeight="SemiBold" Cursor="Hand"/>
                                <Button Grid.Column="4" Style="{StaticResource GreenAction}" Command="{Binding CompleteSaleCommand}"
                                        Content="Place Order" Padding="0,9" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- TYPE QTY PICKER (at least one type with qty ≥ 1) -->
        <Border Grid.RowSpan="2" Panel.ZIndex="1100" Background="#88000000"
                Visibility="{Binding IsTypePickerOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" Width="380" MaxWidth="420" MaxHeight="420" CornerRadius="12"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="14,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Add quantity · مقدار درج کریں" FontSize="12" FontWeight="Bold"
                                   Foreground="#1B4332" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#2E7D32" TextWrapping="Wrap">
                            <Run Text="{Binding SelectedPosProduct.Name, Mode=OneWay}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding SelectedPosProduct.DisplayUrdu, Mode=OneWay}" Foreground="#2D6A4F"/>
                        </TextBlock>
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OrangeAction}"
                                Command="{Binding CloseTypePickerCommand}" Padding="0,7" FontSize="11"/>
                        <Button Grid.Column="2" Content="ADD" Style="{StaticResource GreenAction}"
                                Command="{Binding ConfirmTypeCommand}" Padding="0,7" FontSize="11"/>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                        <ItemsControl ItemsSource="{Binding TypeQtyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7FAF7" CornerRadius="6" Padding="8,5" Margin="0,0,0,4"
                                            BorderBrush="#E2E8E4" BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold"
                                                               FontSize="11" Foreground="#1B4332" TextWrapping="Wrap"/>
                                                    <!-- Per-type note only (not a whole-item note) -->
                                                    <TextBlock Text="{Binding Note}" FontSize="10" FontStyle="Italic"
                                                               Foreground="#4B6354" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PriceDisplay}"
                                                           Foreground="#EF6C00" FontWeight="Bold" FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="4" Content="−" Style="{StaticResource OrangeAction}"
                                                        Command="{Binding DataContext.DecrementTypeQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="0" Height="26" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="5"
                                                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12" FontWeight="Bold"
                                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                         Margin="3,0" MinHeight="26"
                                                         helpers:FocusHelper.DecimalOnly="True"
                                                         helpers:FocusHelper.SelectAllOnFocus="True"/>
                                                <Button Grid.Column="6" Content="+" Style="{StaticResource GreenAction}"
                                                        Command="{Binding DataContext.IncrementTypeQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="0" Height="26" FontSize="13" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- UPDATE MENU ITEM DIALOG (prices / types) -->
        <Border Grid.RowSpan="2" Panel.ZIndex="1150" Background="#88000000"
                Visibility="{Binding IsUpdateMenuItemOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" Width="460" MaxHeight="560" CornerRadius="16"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Update item · آئٹم اپ ڈیٹ" FontSize="16" FontWeight="Bold" Foreground="#1B4332"/>
                        <TextBlock Text="{Binding UpdateMenuItemTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#2D6A4F" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding UpdateMenuItemUrdu}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#40916C" FlowDirection="RightToLeft" Margin="0,2,0,0"
                                   Visibility="{Binding UpdateMenuItemUrdu, Converter={StaticResource StringToVis}}"/>
                        <TextBlock Text="Change type count or prices, then Save."
                                   FontSize="11" Foreground="#6B7280" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OrangeAction}"
                                Command="{Binding CloseUpdateMenuItemCommand}" Height="36"/>
                        <Button Grid.Column="2" Content="✓ Save Update" Style="{StaticResource GreenAction}"
                                Command="{Binding SaveUpdateMenuItemCommand}" Height="36"/>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="Types · اقسام" FontSize="11" FontWeight="SemiBold" Foreground="#4B6354" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding DailyTypeCountOptions}"
                                  SelectedItem="{Binding SelectedUpdateTypeCountOption, Mode=TwoWay}"
                                  DisplayMemberPath="Label" IsEditable="False"
                                  Style="{StaticResource CompactCombo}"
                                  ToolTip="Select Type 1 … Type 10"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="Set price · قیمت مقرر کریں" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#4B6354" Margin="0,0,0,6"/>
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UpdateTypePriceRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,8,8" Padding="8,6" Background="#F8FAF8"
                                                BorderBrush="#D8E8D8" BorderThickness="1" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                                           Foreground="#1B4332" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource HintTextBox}"
                                                         Tag="Price"
                                                         helpers:FocusHelper.NumericOnly="True"
                                                         helpers:FocusHelper.SelectAllOnFocus="True"/>
                                                <TextBlock Text="Note · نوٹ" FontSize="9" Foreground="#6B7280" Margin="0,6,0,2"/>
                                                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource HintTextBox}"
                                                         Tag="e.g. fresh / special"
                                                         MaxLength="80"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>

        <!-- QUANTITY PICKER -->
        <Border Grid.RowSpan="2" Panel.ZIndex="1100" Background="#88000000"
                Visibility="{Binding IsQuantityPickerOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" Width="340" CornerRadius="16" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="مقدار درج کریں" FontSize="16" FontWeight="Bold" Foreground="#1B4332" FlowDirection="RightToLeft"/>
                    <TextBlock FontSize="14" Margin="0,8,0,4" Foreground="#374151" TextWrapping="Wrap">
                        <Run Text="{Binding SelectedPosProduct.Name, Mode=OneWay}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding SelectedType.TypeName, Mode=OneWay}"/>
                    </TextBlock>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="−" Style="{StaticResource OrangeAction}"
                                Command="{Binding DecrementQuantityCommand}" Padding="0" Height="48"
                                ToolTip="Decrease by 1"/>
                        <TextBox x:Name="QuantityPickerBox"
                                 Grid.Column="1"
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="10,0"
                                 helpers:FocusHelper.DecimalOnly="True"
                                 helpers:FocusHelper.SelectAllOnFocus="True"
                                 ToolTip="Enter quantity (decimals OK, e.g. 0.5)"/>
                        <Button Grid.Column="2" Content="+" Style="{StaticResource GreenAction}"
                                Command="{Binding IncrementQuantityCommand}" Padding="0" Height="48"
                                ToolTip="Increase by 1"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedType.Note, Mode=OneWay}" FontSize="11" FontStyle="Italic"
                               Foreground="#4B6354" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,6"
                               Visibility="{Binding SelectedType.Note, Converter={StaticResource StringToVis}}"/>
                    <TextBlock Text="{Binding SelectedTypePrice, StringFormat='Unit price: Rs.{0:N0}'}" HorizontalAlignment="Center"
                               Foreground="#EF6C00" FontWeight="Bold" FontSize="14" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OrangeAction}" Command="{Binding CloseQuantityPickerCommand}"/>
                        <Button Grid.Column="2" Content="ADD" Style="{StaticResource GreenAction}" Command="{Binding ConfirmQuantityAndAddCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Registration Overlay -->
        <Grid Background="#66000000" Grid.RowSpan="2" Panel.ZIndex="1000"
              Visibility="{Binding IsRegistrationVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="14" Padding="24">
                <StackPanel>
                    <TextBlock Text="نیا کسٹمر" FontSize="18" FontWeight="Bold" Foreground="#1B4332" FlowDirection="RightToLeft"/>
                    <TextBlock Text="Register New Customer" FontSize="12" Foreground="#6B7280" Margin="0,0,0,16"/>
                    <TextBlock Text="Full Name *" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,10"
                             helpers:FocusHelper.SelectAllOnFocus="True"/>
                    <TextBlock Text="Phone *" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,10"
                             helpers:FocusHelper.NumericOnly="True"
                             helpers:FocusHelper.SelectAllOnFocus="True"/>
                    <TextBlock Text="Address (Optional)" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,12"
                             helpers:FocusHelper.SelectAllOnFocus="True"/>
                    <TextBlock Text="{Binding RegistrationErrorMessage}" Foreground="#C62828" FontSize="12" Margin="0,0,0,10"
                               Visibility="{Binding RegistrationErrorMessage, Converter={StaticResource StringToVis}}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OrangeAction}" Command="{Binding ToggleRegistrationCommand}"/>
                        <Button Grid.Column="2" Content="Save" Style="{StaticResource GreenAction}" Command="{Binding SaveNewCustomerCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Customer previous bills / due overlay -->
        <Border Grid.RowSpan="2" Panel.ZIndex="950" Background="#80000000"
                Visibility="{Binding IsCustomerHistoryOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Width="520" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#1B4332" CornerRadius="16,16,0,0" Padding="18,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding SelectedCustomer.PrimaryPhone}" FontSize="12" Foreground="#C8E6C9" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding PendingCreditDisplay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FFCDD2" Margin="0,6,0,0"
                                           Visibility="{Binding HasPendingCredit, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="No pending dues" FontSize="12" Foreground="#A5D6A7" Margin="0,6,0,0"
                                           Visibility="{Binding HasPendingCredit, Converter={StaticResource InvBoolToVis}}"/>
                            </StackPanel>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16"
                                    Command="{Binding CloseCustomerHistoryCommand}"/>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="#E8EEE8" BorderThickness="0,1,0,0">
                        <Button Content="Close" Style="{StaticResource OrangeAction}"
                                Command="{Binding CloseCustomerHistoryCommand}"
                                HorizontalAlignment="Right" Padding="18,8"/>
                    </Border>

                    <DockPanel Margin="14">
                        <TextBlock DockPanel.Dock="Top" Text="Previous bills · پرانی بلز"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#4B6354" Margin="0,0,0,8"/>
                        <TextBlock DockPanel.Dock="Top" Text="No previous bills for this customer."
                                   Foreground="#9CA3AF" FontSize="12" Margin="0,20,0,0" HorizontalAlignment="Center"
                                   Visibility="{Binding CustomerBills.Count, Converter={StaticResource InverseCountToVis}}"/>
                        <ListBox ItemsSource="{Binding CustomerBills}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7FAF7" CornerRadius="10" Padding="12,10" BorderBrush="#D8E8D8" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="#1B4332">
                                                    <Run Text="Bill #"/>
                                                    <Run Text="{Binding InvoiceNumber, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,2,0,0">
                                                    <Run Text="{Binding CreatedAt, StringFormat='{}{0:dd MMM yyyy HH:mm}', Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding PaymentStatus, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Margin="0,4,0,0">
                                                    <Run Text="Total " Foreground="#4B6354"/>
                                                    <Run Text="{Binding GrandTotal, StringFormat='Rs.{0:N0}', Mode=OneWay}" Foreground="#1B4332" FontWeight="SemiBold"/>
                                                    <Run Text="   Due " Foreground="#4B6354"/>
                                                    <Run Text="{Binding RemainingAmount, StringFormat='Rs.{0:N0}', Mode=OneWay}" Foreground="#C62828" FontWeight="Bold"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="View" Style="{StaticResource GreenAction}"
                                                        Padding="12,6" FontSize="11" Margin="0,0,0,4"
                                                        Command="{Binding DataContext.ViewCustomerHistoryBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Pay" Style="{StaticResource OrangeAction}"
                                                        Padding="12,6" FontSize="11" Margin="0,0,0,4"
                                                        Visibility="{Binding HasPendingCredit, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.PayCustomerHistoryBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Load" Padding="12,6" FontSize="11"
                                                        Background="#E8F5E9" Foreground="#1B4332" BorderThickness="0"
                                                        ToolTip="Load this bill items into cart"
                                                        Command="{Binding DataContext.LoadCustomerHistoryBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Border>

        <!-- History Payment Overlay -->
        <Border Grid.RowSpan="2" Panel.ZIndex="1000" Background="#80000000"
                Visibility="{Binding IsHistoryPaymentOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1B4332" CornerRadius="16" Padding="28,24" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="420">
                <StackPanel>
                    <TextBlock Text="Record Payment" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Foreground="#94A3B8" FontSize="13" Margin="0,0,0,12">
                        <Run Text="Remaining: Rs. "/>
                        <Run Text="{Binding PreviewHistoryBill.RemainingAmount, StringFormat='{}{0:N0}', Mode=OneWay}" Foreground="#EF4444" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBox Text="{Binding HistoryPaymentAmount, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White"
                             FontSize="20" Padding="12,10" Margin="0,0,0,8"
                             helpers:FocusHelper.DecimalOnly="True"
                             helpers:FocusHelper.SelectAllOnFocus="True"/>
                    <TextBlock Text="Cash over remaining = change given (same as Pay Dues). Online cannot exceed remaining."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding HistoryPaymentError}" Foreground="#F87171" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HistoryPaymentError, Converter={StaticResource StringToVis}}"/>
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedHistoryPaymentMethod}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseHistoryPaymentCommand}" Padding="0,12"/>
                        <Button Grid.Column="2" Content="Record Payment" Command="{Binding RecordHistoryPaymentCommand}"
                                Background="#2E7D32" Foreground="White" Padding="0,12"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Cart Bill Preview Overlay (exact receipt before Place Order) -->
        <Border Grid.RowSpan="2" Panel.ZIndex="2100" Background="#88000000"
                Visibility="{Binding IsCartPreviewOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Width="440" MaxHeight="860"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#1B4332" CornerRadius="16,16,0,0" Padding="18,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Bill Preview" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="  ·  provisional receipt" FontSize="11" Foreground="#95D5B2"
                                           VerticalAlignment="Center" Margin="4,2,0,0"/>
                            </StackPanel>
                            <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                    Foreground="White" FontSize="16" Cursor="Hand" Padding="8,2"
                                    Command="{Binding CloseCartPreviewCommand}"/>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#F8FAF8" Padding="14,12" CornerRadius="0,0,16,16"
                            BorderBrush="#E2E8E4" BorderThickness="0,1,0,0">
                        <Button Content="Close" Style="{StaticResource OrangeAction}"
                                Command="{Binding CloseCartPreviewCommand}" Padding="0,10" FontSize="12"
                                HorizontalAlignment="Stretch"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0">
                        <controls:BillReceiptControl Bill="{Binding CartBillPreview}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- Bill Detail Overlay -->
        <Border Grid.RowSpan="2" Panel.ZIndex="2000" Background="#80000000"
                Visibility="{Binding IsBillDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Width="400" MaxHeight="800" VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#E8F5E9" Padding="20,15">
                        <Grid>
                            <TextBlock Text="Bill Details" FontSize="16" FontWeight="Bold" Foreground="#1B4332"/>
                            <Button Content="X" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                    Command="{Binding CloseBillDetailCommand}"/>
                        </Grid>
                    </Border>
                    <controls:BillReceiptControl Bill="{Binding PreviewHistoryBill}"/>
                </DockPanel>
            </Border>
        </Border>

        <!-- Toasts -->
        <Border Grid.RowSpan="2" Panel.ZIndex="3000" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0"
                Visibility="{Binding SystemErrorVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="20,12" BorderBrush="#EF4444" BorderThickness="2">
                <TextBlock Text="{Binding SystemErrorMessage}" Foreground="#EF4444" FontSize="16" FontWeight="Bold"/>
            </Border>
        </Border>
        <Border Grid.RowSpan="2" Panel.ZIndex="3001" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0"
                Visibility="{Binding PopupSuccessVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="20,12" BorderBrush="#22C55E" BorderThickness="2">
                <TextBlock Text="{Binding PopupSuccessMessage}" Foreground="#22C55E" FontSize="16" FontWeight="Bold"/>
            </Border>
        </Border>
        <Border Grid.RowSpan="2" Panel.ZIndex="3001" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0"
                Visibility="{Binding PopupErrorVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="20,12" BorderBrush="#EF4444" BorderThickness="2">
                <TextBlock Text="{Binding PopupErrorMessage}" Foreground="#EF4444" FontSize="16" FontWeight="Bold"/>
            </Border>
        </Border>
    </Grid>
</UserControl>
